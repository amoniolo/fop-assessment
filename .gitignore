**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Jupyter --------------------------------------------------------------
**/.ipynb_checkpoints/
# Build artefact from the headless test run, not source.
*.executed.ipynb

# --- Editors and OS -------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
